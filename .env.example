APP_NAME="Onboarding AI"
DEBUG=true
# Run `python scripts/create_env.py` to populate this with a strong random key,
# or generate one yourself: python -c 'import secrets; print(secrets.token_urlsafe(48))'
SECRET_KEY=CHANGE_ME_USE_32_CHARS_MINIMUM_RANDOM_STRING

# PostgreSQL — uses Docker Compose service name as host
DATABASE_URL=postgresql+asyncpg://app:postgres@db:5432/app

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Ollama — uses Docker Compose service name as host
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b

# Embedding model (downloaded from HuggingFace on first run)
EMBED_MODEL=BAAI/bge-base-en-v1.5
EMBED_DIMENSION=384

CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K_RETRIEVAL=5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_ENABLED=true
RETRIEVAL_CANDIDATES=20

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=50

# Folder-upload allowlist. Comma-separated absolute paths under which the
# /admin/documents/upload-folder endpoint may scan. Leave empty to disable
# folder uploads entirely (recommended unless you have a specific need).
# Example: ALLOWED_UPLOAD_ROOTS=/app/uploads,/mnt/shared
ALLOWED_UPLOAD_ROOTS=

# Admin account created on first startup
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@company.com
ADMIN_PASSWORD=ChangeMe123!

# HuggingFace model cache — set to your local path to avoid re-downloading models
# Leave unset to use a Docker named volume (models will download on first run)
# HF_CACHE_DIR=/path/to/.cache/huggingface
