APP_NAME="Mnema"
DEBUG=true

# Generate a strong random key:
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
# Or run scripts/create_env.py to populate this file automatically.
SECRET_KEY=CHANGE_ME_USE_32_CHARS_MINIMUM_RANDOM_STRING

# PostgreSQL — uses the Docker Compose service name as host.
# POSTGRES_PASSWORD is read by both the `db` container and the app's
# DATABASE_URL in docker-compose.yml. scripts/create_env.py fills it with a
# strong random value. If you change it here, keep DATABASE_URL below in sync.
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
DATABASE_URL=postgresql+asyncpg://app:CHANGE_ME_STRONG_DB_PASSWORD@db:5432/app

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Ollama — uses the Docker Compose service name as host.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:14b

# Embedding model. EMBED_DIMENSION MUST match the model:
#   BAAI/bge-base-en-v1.5  → 768
#   all-MiniLM-L6-v2       → 384
EMBED_MODEL=BAAI/bge-base-en-v1.5
EMBED_DIMENSION=768

CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K_RETRIEVAL=5
RETRIEVAL_CANDIDATES=20
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_ENABLED=true

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=50

ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Admin account seeded on first startup by scripts/docker_entrypoint.py.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@company.com
ADMIN_PASSWORD=ChangeMe123!

# Optional bind-mount of host HuggingFace cache (skips first-run model download).
# Leave commented to use the named volume.
# HF_CACHE_DIR=/path/to/.cache/huggingface
